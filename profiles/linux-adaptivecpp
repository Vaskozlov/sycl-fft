# Set ACPP_LLVM_VERSION to use that distro Clang as the host compiler too.
include(default)

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
{% set release = os.getenv("ACPP_LLVM_VERSION") %}
{% if release %}
{% set major = release.split(".")[0] %}
tools.build:compiler_executables={"c":"clang-{{ major }}","cpp":"clang++-{{ major }}"}

[options]
adaptivecpp/*:llvm_version={{ release }}
{% endif %}

[settings]
os=Linux
compiler.cppstd=17
{% if release %}
compiler=clang
compiler.version={{ major }}
compiler.libcxx=libstdc++11
{% endif %}
